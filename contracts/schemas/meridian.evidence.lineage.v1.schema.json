{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.meridian.dev/evidence/meridian.evidence.lineage.v1.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "allOf": [
    { "$ref": "meridian.evidence.common.v1.schema.json" },
    {
      "type": "object",
      "required": ["activity", "status", "executionId", "inputs", "outputs", "schemaVersions", "modelVersions", "queryFingerprints", "sourceRevisions", "contextScope", "metadata"],
      "properties": {
        "profile": { "const": "lineage" },
        "kind": { "const": "activity" },
        "activity": { "type": "string", "minLength": 1, "maxLength": 256 },
        "status": { "enum": ["started", "checkpoint", "completed", "failed"] },
        "executionId": { "type": "string", "minLength": 1, "maxLength": 256 },
        "inputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "meridian.evidence.common.v1.schema.json#/$defs/reference" } },
        "outputs": { "type": "array", "uniqueItems": true, "items": { "$ref": "meridian.evidence.common.v1.schema.json#/$defs/reference" } },
        "schemaVersions": { "$ref": "meridian.evidence.common.v1.schema.json#/$defs/stringMap" },
        "modelVersions": { "$ref": "meridian.evidence.common.v1.schema.json#/$defs/stringMap" },
        "queryFingerprints": { "type": "array", "uniqueItems": true, "items": { "$ref": "meridian.evidence.common.v1.schema.json#/$defs/fingerprint" } },
        "sourceRevisions": { "$ref": "meridian.evidence.common.v1.schema.json#/$defs/stringMap" },
        "transformationDigest": { "$ref": "meridian.evidence.common.v1.schema.json#/$defs/fingerprint" },
        "artifactDigest": { "$ref": "meridian.evidence.common.v1.schema.json#/$defs/fingerprint" },
        "actor": { "$ref": "meridian.evidence.common.v1.schema.json#/$defs/reference" },
        "checkpointKey": { "type": "string", "minLength": 1, "maxLength": 256 },
        "contextScope": { "$ref": "meridian.evidence.common.v1.schema.json#/$defs/stringMap" },
        "metadata": { "type": "object", "maxProperties": 128 }
      },
      "if": { "properties": { "status": { "const": "checkpoint" } } },
      "then": { "required": ["checkpointKey"] }
    }
  ],
  "unevaluatedProperties": false
}
